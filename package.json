{
  "name": "dori-solar-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:factory-ui": "playwright test --config playwright.factory.config.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e && npm run test:factory-ui",
    "factory:watch": "tsx factory_runner.ts watch",
    "factory:start": "tsx factory_runner.ts start",
    "factory:once": "tsx factory_runner.ts once",
    "factory:dry-run": "tsx factory_runner.ts dry-run",
    "factory:doctor": "tsx factory_runner.ts doctor",
    "factory:status": "tsx factory_runner.ts status",
    "factory:live": "tsx factory_runner.ts live",
    "factory:web": "tsx factory_runner.ts web",
    "factory:note": "tsx factory_runner.ts note",
    "factory:pause": "tsx factory_runner.ts pause",
    "factory:resume": "tsx factory_runner.ts resume",
    "factory:stop": "tsx factory_runner.ts stop",
    "factory:add": "tsx factory_runner.ts add",
    "factory:retry": "tsx factory_runner.ts retry"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "astronomy-engine": "2.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.2",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/cross-spawn": "^6.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "cross-spawn": "^7.0.6",
    "postcss": "^8.5.6",
    "proper-lockfile": "^4.1.2",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  }
}
